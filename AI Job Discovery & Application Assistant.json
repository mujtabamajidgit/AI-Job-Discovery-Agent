    {
      "parameters": {
        "jsCode": "const job = $input.first().json;\nconst PROFILE = \"Mujtaba Majid Baig. BS Software Engineering student in Karachi (graduating 2027). Builds AI automation workflows with n8n: AI agents (Gemini, Groq), Google Sheets, Airtable, Gmail, HTTP requests, forms, schedules. Six projects: lead qualification, restaurant support agent, medical store inventory, car showroom agent, website monitor, auto email reply. 3+ years B2B sales and international business development. Basic Python, HTML, CSS, Git. Looking for junior or internship roles, remote.\";\nconst prompt = 'You are a careful job-matching assistant. Compare the candidate to the job. Score from 0 to 100 how well the candidate fits an entry-level application. Be honest, do not invent skills.\\n\\nCANDIDATE:\\n' + PROFILE +\n '\\n\\nJOB:\\nTitle: ' + job.title + '\\nCompany: ' + job.company + '\\nLocation: ' + job.location + '\\nType: ' + job.jobType + '\\nDescription: ' + job.description +\n '\\n\\nReturn ONLY JSON with keys: score (number 0-100), reason (one short sentence), applyAngle (one short sentence: which of the candidate projects to mention).';\nconst aiBody = { contents: [{ parts: [{ text: prompt }] }], generationConfig: { responseMimeType: 'application/json', temperature: 0.2 } };\nreturn [{ json: { ...job, aiBody } }];"
      },
      "id": "c1f3bc90-fef7-45ab-a21e-92daedf06ce3",
      "name": "Build AI Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2080,
        160
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-goog-api-key",
              "value": "PASTE_YOUR_GEMINI_API_KEY_HERE"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.aiBody) }}",
        "options": {}
      },
      "id": "20d4064a-98ef-4f37-89c7-ecd0d13fe54e",
      "name": "AI Match & Score",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2304,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const job = { ...$('Build AI Request').item.json };\ndelete job.aiBody;\nlet result = { aiOk: false, score: 0, reason: '', applyAngle: '' };\ntry {\n  const text = $json.candidates[0].content.parts[0].text;\n  const p = JSON.parse(text);\n  const score = Number(p.score);\n  if (score >= 0 && score <= 100) result = { aiOk: true, score, reason: String(p.reason || ''), applyAngle: String(p.applyAngle || '') };\n} catch (e) { result.reason = 'AI answer could not be read'; }\nreturn [{ json: { ...job, ...result } }];"
      },
      "id": "34e9b2c4-e3d8-4a5a-9ace-a0fb99b786ea",
      "name": "Validate AI Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2528,
