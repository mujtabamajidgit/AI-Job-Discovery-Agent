    {
      "parameters": {
        "jsCode": "const f = $input.first().json;\nconst jobTitle = String(f['Job Title'] || '').trim();\nconst minScore = Number(f['Minimum Score']);\nconst email = String(f['Your Email'] || '').trim();\nlet error = '';\nif (jobTitle.length < 3) error = 'Job title is too short.';\nelse if (!(minScore >= 0 && minScore <= 100)) error = 'Minimum score must be a number from 0 to 100.';\nelse if (!/^\\S+@\\S+\\.\\S+$/.test(email)) error = 'Email address is not valid.';\nreturn [{ json: { ok: error === '', error, jobTitle, minScore, email } }];"
      },
      "id": "4623c973-183a-45f0-b695-4f72aaa07e23",
      "name": "Parse & Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -336,
        32
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.ok }}",
              "value2": true
            }
          ]
        }
      },
      "id": "f2146f93-a6f7-4896-97c7-1d7f80147835",
      "name": "Input Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        -128,
        32
      ]
    },
    {
      "parameters": {
        "errorMessage": "={{ $json.error }}"
