    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst searchUrl = 'https://remotive.com/api/remote-jobs?limit=40&search=' + encodeURIComponent(j.jobTitle);\nreturn [{ json: { ...j, searchUrl } }];"
      },
      "id": "a3f90f35-ed9b-47d1-bb7e-220cd9d7bcb3",
      "name": "Build Search Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        112,
        32
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.searchUrl }}",
        "options": {}
      },
      "id": "0fd2bb89-515c-4c2c-ae84-dc8018de02c4",
      "name": "Fetch Jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        320,
        32
      ]
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Parse & Validate Input').first().json;\nconst jobs = $input.first().json.jobs || [];\nconst clean = (h) => String(h || '').replace(/<[^>]*>/g, ' ').replace(/&nbsp;|&amp;|&#?\\w+;/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, 1500);\nreturn jobs.map(j => ({ json: {\n  jobId: j.id, title: j.title || '', company: j.company_name || '', location: j.candidate_required_location || 'Not stated',\n  jobType: j.job_type || '', salary: j.salary || '', url: j.url || '', published: (j.publication_date || '').slice(0, 10),\n  description: clean(j.description), minScore: ctx.minScore, email: ctx.email, jobTitle: ctx.jobTitle } }));"
      },
      "id": "24b047eb-f2f2-4bc7-8949-7590f06d02f9",
      "name": "Normalize Jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        544,
        32
      ]
    },
    {
      "parameters": {
        "jsCode": "const seen = new Set();\nconst blocked = /\\b(senior|sr\\.?|lead|principal|head|director|vp|staff|manager|architect)\\b/i;\nconst out = [];\nfor (const it of $input.all()) {\n  const j = it.json;\n  if (!j.url || seen.has(j.url)) continue;\n  seen.add(j.url);\n  if (blocked.test(j.title)) continue;\n  out.push({ json: j });\n}\nreturn out.length ? out : [{ json: { _empty: true } }];"
      },
      "id": "0abce7eb-37ad-4192-b636-37acd37917b7",
      "name": "Dedupe & Hard Filters",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        768,
        32
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ !$json._empty }}",
              "value2": true
            }
          ]
        }
      },
