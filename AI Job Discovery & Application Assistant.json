    {
      "parameters": {
        "jsCode": "const tracked = new Set($input.all().map(i => i.json.URL).filter(Boolean));\nconst jobs = $('Any Jobs?').all().map(i => i.json).filter(j => !tracked.has(j.url));\nreturn jobs.length ? jobs.map(json => ({ json })) : [{ json: { _empty: true } }];"
      },
