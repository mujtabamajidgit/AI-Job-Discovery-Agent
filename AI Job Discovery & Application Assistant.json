      "id": "054ba9e2-5c80-465e-a76e-7c38eed476a8",
      "name": "Save to Tracker",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        3632,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const email = $('Parse & Validate Input').first().json.email;\nconst rows = $input.all().map(i => i.json);\nconst top = rows.filter(r => r.Status === 'Shortlisted').sort((a, b) => Number(b.Score) - Number(a.Score));\nconst esc = s => String(s || '').replace(/[&<>]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));\nlet html = '<h2>Your AI Job Finder results</h2><p>New jobs checked: ' + rows.length + '. Shortlisted: ' + top.length + '.</p>';\nif (!top.length) html += '<p>No job reached your minimum score this time. All jobs are saved in your Tracker sheet.</p>';\nfor (const r of top) {\n  html += '<hr><h3>' + esc(r['Job Title']) + ' at ' + esc(r.Company) + ' (score ' + esc(r.Score) + ')</h3>' +\n   '<p>' + esc(r.Location) + ' | ' + esc(r.Type) + '</p><p><b>Why:</b> ' + esc(r.Reason) + '</p>' +\n   '<p><b>Mention:</b> ' + esc(r['Apply Angle']) + '</p><p><a href=\"' + esc(r.URL) + '\">Open job</a></p>';\n}\nhtml += '<hr><p>Please review each job yourself before you apply. Jobs by Remotive (remotive.com).</p>';\nreturn [{ json: { email, subject: 'AI Job Finder: ' + top.length + ' job(s) shortlisted', html } }];"
      },
